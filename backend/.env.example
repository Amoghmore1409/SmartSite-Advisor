# ==============================
# SmartSite Backend - Environment Variables
# ==============================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database (MongoDB Atlas) ---
# Get this from: Atlas Dashboard → Your Cluster → Connect → Drivers
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=

# --- Security ---
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# --- CORS ---
CLIENT_ORIGIN=http://localhost:3000

# --- Scoring Engine (Python microservice — see /scoring-engine and PYTHON_SETUP.md) ---
# The backend auto-starts this on server startup if it isn't already running.
# Only needed if the Python executable isn't discoverable as `python`/`python3`.
SCORING_ENGINE_URL=http://localhost:5001
PYTHON_EXECUTABLE=

# --- Environmental Scoring (OpenWeatherMap free tier) ---
OPENWEATHERMAP_API_KEY=
